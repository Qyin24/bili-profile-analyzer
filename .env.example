# ==============================================================================
# BiliProfile Analyzer — Environment Variables Template (Phase 3.1)
# ==============================================================================
# Copy this file to `.env` or `.env.local` for local development.
# NOTE: Do NOT commit `.env`, `.env.local` or any sensitive keys to source control.
# ==============================================================================

# Database Configuration (PostgreSQL)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public"

# Application Metadata
NEXT_PUBLIC_APP_NAME="BiliProfile Analyzer"
NEXT_PUBLIC_APP_ENV="development"

# Phase 4.0/4.1 公开能力验证探针目标（仅供项目所有者受控验证）
# 规则说明：
# 1. 留空时探针自动输出 SKIPPED_NOT_CONFIGURED，绝不发起网络请求。
# 2. 仅允许严格格式: https://space.bilibili.com/<纯数字UID>（禁止携带查询参数、哈希或非数字路径，否则输出 SKIPPED_INVALID_CONFIGURATION）。
# 3. 禁止在此处填写非项目所有者授权的 URL，禁止提交包含真实 URL 的 .env 文件。
BILIPROFILE_PROBE_URL=

# Phase 4.2 最小字段信号受控验证开关（仅供单次测试）
# 规则说明：
# 1. 仅当设置为 true 且同时配置了合法的 BILIPROFILE_PROBE_URL 时，执行单次最小流式 title 信号探测。
# 2. 未设置或设为 false 时，字段探测命令安全跳过，不发起网络请求。
BILIPROFILE_FIELD_VALIDATION_ENABLED=

# Phase 4.4 个人空间展示名称最小信号受控验证开关（仅供单次测试）
# 规则说明：
# 1. 仅当设置为 true 且同时配置了合法的 BILIPROFILE_PROBE_URL 时，执行单次最小展示名称标签信号探测。
# 2. 未设置或设为 false 时，展示名称探测命令安全跳过，不发起网络请求。
BILIPROFILE_PROFILE_LABEL_VALIDATION_ENABLED=

# ------------------------------------------------------------------------------
# 受控测试数据清理令牌（E2E 验收专用，仅服务端）
# 用途：
#   - POST /api/tasks 携带合法令牌时，允许创建 isTest=true 的测试任务/目标
#   - DELETE /api/admin/test-cleanup/[taskId] 精准清理测试数据（按精确 taskId，级联子表）
# 规则：
#   - 绝不可加 NEXT_PUBLIC_ 前缀（必须仅服务端可见）
#   - Preview 与 Production 必须使用不同的值（按 Vercel 环境分别设置）
#   - 未设置时，任何测试数据都无法被创建或清理（fail-closed）
# 生成示例： openssl rand -hex 24
# ------------------------------------------------------------------------------
TEST_CLEANUP_TOKEN=
