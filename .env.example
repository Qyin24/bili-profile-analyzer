# ==============================================================================
# BiliProfile Analyzer — Environment Variables Template (Phase 4.2)
# ==============================================================================
# Copy this file to `.env` or `.env.local` for local development.
# NOTE: Do NOT commit `.env` or any sensitive keys to source control.
# ==============================================================================

# Database Configuration (SQLite for local development)
DATABASE_URL="file:./dev.db"

# Application Metadata
NEXT_PUBLIC_APP_NAME="BiliProfile Analyzer"
NEXT_PUBLIC_APP_ENV="development"

# Phase 4.0/4.1 公开能力验证探针目标（仅供项目所有者受控验证）
# 规则说明：
# 1. 留空时探针自动输出 SKIPPED_NOT_CONFIGURED，绝不发起网络请求。
# 2. 仅允许严格格式: https://space.bilibili.com/<纯数字UID>（禁止携带查询参数、哈希或非数字路径，否则输出 SKIPPED_INVALID_CONFIGURATION）。
# 3. 禁止在此处填写非项目所有者授权的 URL，禁止提交包含真实 URL 的 .env 文件。
BILIPROFILE_PROBE_URL=

# Phase 4.2 最小字段信号受控验证开关（仅供单次测试）
# 规则说明：
# 1. 仅当设置为 true 且同时配置了合法的 BILIPROFILE_PROBE_URL 时，执行单次最小流式 title 信号探测。
# 2. 未设置或设为 false 时，字段探测命令安全跳过，不发起网络请求。
BILIPROFILE_FIELD_VALIDATION_ENABLED=
